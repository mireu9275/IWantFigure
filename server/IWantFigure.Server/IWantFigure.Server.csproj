<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>IWantFigure.Server</RootNamespace>
    <AssemblyName>IWantFigure.Server</AssemblyName>
    <!-- No ICU needed: we never format culture-specific text. Keeps the Docker image small. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>iwantfigure-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Image decode / EXIF auto-orient / resize / JPEG re-encode. Pinned to the 3.x line. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Single source of truth: the schema, the system prompt and the mock sample live in
      /shared and are shared with the Flutter app. They are LINKED (not copied) into this
      project as embedded resources, so there is exactly one copy in the repository.
      SharedResources.cs reads them by LogicalName.
    -->
    <EmbeddedResource Include="..\..\shared\analysis.schema.json"
                      Link="Shared\analysis.schema.json"
                      LogicalName="IWantFigure.Shared.analysis.schema.json" />
    <EmbeddedResource Include="..\..\shared\prompt\system_prompt.md"
                      Link="Shared\prompt\system_prompt.md"
                      LogicalName="IWantFigure.Shared.system_prompt.md" />
    <EmbeddedResource Include="..\..\shared\samples\bridge_parallel.json"
                      Link="Shared\samples\bridge_parallel.json"
                      LogicalName="IWantFigure.Shared.bridge_parallel.json" />
  </ItemGroup>

</Project>
