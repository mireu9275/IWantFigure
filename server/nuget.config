<?xml version="1.0" encoding="utf-8"?>
<!--
  Pin package sources to nuget.org so restore does not depend on
  machine-wide NuGet configs (e.g. leftover SDK/vendor offline folders).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
